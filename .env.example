# IntraHub の入力変数のひな形。
#
#   cp .env.example .env
#
# の上で、この環境の値と秘密情報を埋める。.env はコミットしない（.gitignore 対象）。
# 各変数の要否・既定値・用途は docs/変数一覧.md を参照する。
# 空のまま起動すると、必須変数は docker compose config の時点でエラーになる。

# ---- 共通 ----
# 全サービスの永続データを置くホスト側のルートパス（絶対パス）
DATA_ROOT=
# コンテナのタイムゾーン（IANA名）
TZ=UTC

# ---- caddy ----
# 各サービスのFQDNに使うベースドメイン（権威DNSを持つ実在ドメイン）
BASE_DOMAIN=
# ホストへ公開するHTTP/HTTPSポート
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# ACME DNS-01 用。対象ゾーンの Zone:Read と DNS:Edit だけを許可したトークン
CLOUDFLARE_API_TOKEN=

# ---- mediavault ----
# MediaVault のアップロード領域と専用PostgreSQLを置くホスト側パス
MEDIAVAULT_ROOT=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# /internal/* の Bearer 認証キー。空だと内部APIが無認証になる
INTERNAL_API_KEY=
# mediavault-web を配信するオリジン（単一のみ。不正値はapi起動時にpanicする）
CORS_ALLOWED_ORIGIN=
# 外部メタデータAPI。未設定のプロバイダは起動時のseedをスキップする
TMDB_API_KEY=
STEAM_API_KEY=
STEAM_USER_ID=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
ANNICT_ACCESS_TOKEN=
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=
# mediavault-worker 用。worker 実装までは未使用
LLM_BASE_URL=
LLM_API_KEY=

# ---- vllm ----
VLLM_API_KEY=
# Hugging Face の gated モデルを取得する場合のみ必要
HF_TOKEN=

# ---- litellm ----
# 稼働させるバージョン。空だと起動しない
LITELLM_IMAGE_TAG=
LITELLM_MASTER_KEY=
# vLLM 障害時のフォールバック先。使わないなら空でよい
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- hermes-agent ----
HERMES_PG_PASSWORD=
TELEGRAM_BOT_TOKEN=

# ---- open-deep-research ----
# langgraph build でローカルに作ったイメージのタグ。空だと起動しない
ODR_IMAGE_TAG=
ODR_PG_PASSWORD=
TAVILY_API_KEY=
LANGSMITH_API_KEY=

# ---- monitoring ----
# beszel hub が発行する agent 登録キー
BESZEL_AGENT_KEY=

# ---- samba ----
SAMBA_USER=
SAMBA_PASSWORD=
