# IntraHubの全設定。コピーした.envは秘密情報を含むためコミットしない。

# 共通（全コンテナ）
TZ=UTC
BIND_ADDRESS=127.0.0.1

# 共有ストレージ（MediaVault / Jellyfin / BookOrbit / Samba / AIコンテナ）
LIBRARY_UID=1000
LIBRARY_GID=1000
LIBRARY_SOURCE=shares
KNOWLEDGE_SOURCE=knowledge

# Knowledge Vault の初期化（knowledge-init）
# 起動のたびに seed のバージョンと導入済みバージョンを比較し、seed が新しいときだけ上書きする。
# true にすると、バージョンが同じでも管理対象ファイルを強制的に再配置する。
# 上書きの直前に現状がコミットされるため、人手編集は git から戻せる。
KNOWLEDGE_SEED_FORCE=false

# MediaVault（mediavault-postgres / mediavault-api / mediavault-mcp / mediavault-extractor / mediavault-web）
MEDIAVAULT_ALLOWED_ORIGIN=http://127.0.0.1:8080
MEDIAVAULT_DB_PASSWORD=

# 内部API用キー。api / mcp / extractor で共有する必須項目。
# openssl rand -base64 32 で生成した値を設定する
INTERNAL_API_KEY=

# MediaVault-mcp
# openssl rand -base64 48 で生成した値を設定する
MCP_AUTH_TOKEN=
# LAN内からの直接アクセス用。特定インターフェースに限定したい場合はホストIPを指定する
MCP_BIND_ADDRESS=0.0.0.0
# mcp のログレベル (error/warn/info/debug/trace)
RUST_LOG=info

# MediaVault-extractor
# OCR 実行デバイス。cpu / cuda
EXTRACTOR_OCR_DEVICE=cpu
EXTRACTOR_MAX_CONCURRENCY=1
EXTRACTOR_POLL_INTERVAL_SEC=5
EXTRACTOR_HEARTBEAT_INTERVAL_SEC=30
EXTRACTOR_LEASE_SECONDS=300
EXTRACTOR_JOB_TIMEOUT_SEC=3600

# 既定の名前付きボリューム、またはホストの絶対パスを指定する。
MEDIAVAULT_DB_SOURCE=mediavault-db
MEDIAVAULT_STORAGE_SOURCE=mediavault-storage

# 外部メタデータ API。未設定のプロバイダーは利用できない。
TMDB_API_KEY=
STEAM_API_KEY=
STEAM_USER_ID=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
ANNICT_ACCESS_TOKEN=
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=

# Jellyfin
JELLYFIN_CONFIG_SOURCE=jellyfin-config
JELLYFIN_CACHE_SOURCE=jellyfin-cache

# BookOrbit
BOOKORBIT_DB_PASSWORD=
BOOKORBIT_JWT_SECRET=
BOOKORBIT_SETUP_BOOTSTRAP_TOKEN=
BOOKORBIT_APP_URL=http://127.0.0.1:3000
BOOKORBIT_DB_SOURCE=bookorbit-db
BOOKORBIT_APP_DATA_SOURCE=bookorbit-app-data

# Samba
SAMBA_USER=intrahub
SAMBA_PASSWORD=

# Bookmarks
BOOKMARKS_USER=intrahub
BOOKMARKS_PASSWORD=
BOOKMARKS_DATA_SOURCE=bookmarks-data

# LiteLLM
LITELLM_MASTER_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=anthropic/<model-id>
OPENAI_API_KEY=
OPENAI_MODEL=openai/<model-id>
LITELLM_DATA_SOURCE=litellm-data

# Mastra
# MASTRA_LLM_MODEL: anthropic / openai / vllm
# MediaVault MCPへの接続はMediaVault側のMCP_AUTH_TOKENを共有する。
MASTRA_LLM_MODEL=anthropic
MASTRA_DATA_SOURCE=mastra-data

# Hermes Agent（hermes-postgres / hermes-agent）
HERMES_DB_PASSWORD=
HERMES_UID=1000
HERMES_GID=1000
# HERMES_LLM_MODEL: anthropic / openai / vllm
HERMES_LLM_MODEL=openai
TELEGRAM_BOT_TOKEN=
HERMES_DATA_SOURCE=hermes-db
HERMES_PGDATA_SOURCE=hermes-pgdata

# Netdata
NETDATA_CONFIG_SOURCE=netdata-config
NETDATA_LIB_SOURCE=netdata-lib
NETDATA_CACHE_SOURCE=netdata-cache

# vLLM（compose.vllm.yamlを使う場合）
VLLM_MODEL=<hugging-face-model-id>
VLLM_SERVED_MODEL_NAME=local
VLLM_API_KEY=
VLLM_CACHE_SOURCE=vllm-cache
HF_TOKEN=
# 実行時チューニング（未設定時は既定値を使う）
VLLM_MAX_MODEL_LEN=32768
VLLM_MAX_NUM_SEQS=1
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_TOOL_CALL_PARSER=openai
VLLM_GPU_COUNT=1
VLLM_SHM_SIZE=4gb

# Open Deep Research（compose.research.yamlを使う場合）
# ODR_LLM_MODEL: anthropic / openai / vllm
# ODR_LLM_MODEL=anthropic
# ODR_DB_PASSWORD=
# TAVILY_API_KEY=
# LANGSMITH_API_KEY=
# ODR_PGDATA_SOURCE=odr-pgdata
# ODR_REDIS_SOURCE=odr-redis-data
