# IntraHub標準構成の非秘密設定。
# APIキーとパスワードは書かず、runtime/secrets/へ1項目1ファイルで保存する。

# 共通
TZ=UTC
BIND_ADDRESS=127.0.0.1

# 公開ポート
MEDIAVAULT_PORT=8080
BOOKMARKS_PORT=8082
CALIBRE_PORT=8083
JELLYFIN_PORT=8096
LITELLM_PORT=4000
MASTRA_PORT=4111
SAMBA_PORT=445

# 共有ライブラリの所有権
LIBRARY_UID=1000
LIBRARY_GID=1000
LIBRARY_UMASK=0002

# LiteLLMのproviderモデル。
# 対応するAPIキーがruntime/secrets/litellm/にあるproviderだけが有効になる。
ANTHROPIC_MODEL=anthropic/<model-id>
OPENAI_MODEL=openai/<model-id>

# AIクライアントが通常利用するLiteLLM論理モデル名
MASTRA_LLM_MODEL=anthropic
HERMES_LLM_MODEL=openai

# compose.storage.yamlを使う場合だけ設定する。
# DATA_ROOT=/srv/intrahub
# LIBRARY_ROOT=/mnt/library
# MODEL_CACHE_ROOT=/mnt/nvme/vllm

# compose.gpu.yamlを使う場合だけ設定する。
# VLLM_MODEL=<hugging-face-model-id>
# VLLM_SERVED_MODEL_NAME=local

# compose.research.yamlを使う場合だけ設定する。
# ODR_PORT=8000
# ODR_LLM_MODEL=anthropic
