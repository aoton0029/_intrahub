# bootstrap.sh が runtime/config/litellm/config.yaml を生成するための完全構成テンプレート。
# 未設定providerの項目は生成時に除外する。
# APIキーはこのファイルへ書かず、実行時の環境変数から取得する。

model_list:
  - model_name: anthropic
    litellm_params:
      model: os.environ/ANTHROPIC_MODEL
      api_key: os.environ/ANTHROPIC_API_KEY

  - model_name: openai
    litellm_params:
      model: os.environ/OPENAI_MODEL
      api_key: os.environ/OPENAI_API_KEY

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
